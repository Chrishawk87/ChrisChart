# ---- required ----
# Without this the service starts LOCKED: it serves /health and refuses
# everything else. Generate one with: openssl rand -hex 24
LIQMAP_TOKEN=

# ---- strongly recommended on Railway ----
# Mount a Volume in the Railway service settings, then point this at it.
# Without a volume the container filesystem is rebuilt on every deploy and
# ALL sweep history, change events and resolved outcomes are destroyed.
LIQMAP_DB=/data/liqmap.db

# ---- wallet universe ----
# Comma-separated addresses, or leave blank and POST /api/wallets instead.
LIQMAP_WALLETS=

# ---- defaults for a fresh database (editable later in the dashboard) ----
LIQMAP_COINS=BTC,ETH
LIQMAP_SIGMA=0.0006
LIQMAP_HORIZON=240
LIQMAP_BUCKET_BPS=25
LIQMAP_MIN_CLUSTER=250000
LIQMAP_MAX_DISTANCE=0.25
LIQMAP_SWEEP_MIN=30
LIQMAP_PRICE_SEC=30
LIQMAP_WALLET_LIMIT=600
LIQMAP_MIN_WALLET=25000

# Set true to have the web service also collect on a background thread.
LIQMAP_AUTO=false
