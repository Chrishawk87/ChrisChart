__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Secrets and local state — never commit these
.env
*.db
wallets.json
*.npy
.DS_Store

# Market data. DBN files run to gigabytes; a single accidental commit of one
# is permanent in git history and effectively unremovable from a shared repo.
data/
*.dbn
*.dbn.zst
*.db-shm
*.db-wal
*.db-journal

# Node artifacts for the mev/ service. node_modules is large and
# platform-specific; dist/ is build output. Neither belongs in git, and
# Railway installs them itself at build time.
node_modules/
mev/node_modules/
mev/dist/

# Compiled contract output. Reproducible from source with `npm run compile`,
# and a stale copy in git is worse than none.
mev/MevArb.deploy.hex
